{
  "name": "leashed",
  "version": "1.0.0",
  "private": true,
  "description": "Leashed: an AI treasurer that cannot move money alone. Approvals are Tide-signed; the bank re-verifies them.",
  "type": "module",
  "scripts": {
    "tide:bootstrap": "ADAPTER_OUTPUT=data/tidecloak.json bash scripts/bootstrap-tidecloak.sh && cp data/tidecloak.json public/tidecloak.json",
    "tide:seed": "bash scripts/seed-leashed-realm.sh",
    "tide:start": "docker start tidecloak",
    "tide:finish": "bash scripts/finish-bootstrap.sh",
    "dev": "concurrently -k -p \"[{name}]\" -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "dev:live": "LEASHED_IDP=tidecloak npm run dev",
    "server": "tsx server/index.ts",
    "client": "vite --port 5173 --host",
    "build": "vite build",
    "test": "tsx server/tests/verification.ts",
    "lint": "tsc --noEmit",
    "test:e2e": "node scripts/e2e-sim.mjs"
  },
  "dependencies": {
    "@tidecloak/react": "0.14.17",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jose": "^5.9.6",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.1"
  }
}
