# Copy to .env (gitignored). Never commit real values.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=
# The address that will manage your Tide licence, and your explicit agreement to https://tide.org/legal
TIDE_LICENSE_EMAIL=
TIDE_TERMS_ACCEPTED=
# Local: leave the next two unset (defaults http://localhost:8080 and http://localhost:5173).
# GitHub Codespaces: https://<codespace-name>-8080.app.github.dev and https://<codespace-name>-5173.app.github.dev
TIDECLOAK_PUBLIC_URL=
CLIENT_APP_URL=
